{
  "name": "ephemio",
  "description": "Create and control a short-lived disposable browser, code, or desktop workspace. Always terminate the workload in a finally path.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["operation"],
    "properties": {
      "operation": {
        "type": "string",
        "enum": ["create", "inspect", "command", "file_write", "file_read", "file_list", "browser_actions", "artifact_export", "intervention_request", "takeover", "resume", "complete", "fail", "terminate"]
      },
      "workload_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
      "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 100},
      "profile": {"type": "string", "enum": ["browser", "code", "desktop"]},
      "execution_policy": {"type": "string", "enum": ["autonomous", "supervised", "autonomous_with_fallback"]},
      "requested_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
      "idle_policy": {"type": "string", "enum": ["5", "15", "30", "60", "keep_running"]},
      "arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "working_directory": {"type": "string"},
      "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
      "path": {"type": "string"},
      "contents": {"type": "string"},
      "overwrite": {"type": "boolean"},
      "url": {"type": "string", "format": "uri"},
      "actions": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
      "artifact_name": {"type": "string"},
      "reason": {"type": "string", "maxLength": 100}
    }
  }
}
